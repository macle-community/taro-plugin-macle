{
  "name": "@macle-community/taro-plugin-macle",
  "version": "1.0.0",
  "description": "Taro 3/4 platform plugin for Macle (Huawei / Ethio Telecom Mini Program)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "components-react": [
        "dist/components-react.d.ts"
      ],
      "components": [
        "dist/components.d.ts"
      ],
      "apis": [
        "dist/apis.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./components-react": {
      "types": "./dist/components-react.d.ts",
      "import": "./dist/components-react.js",
      "require": "./dist/components-react.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js",
      "require": "./dist/components.js"
    },
    "./apis": {
      "types": "./dist/apis.d.ts",
      "import": "./dist/apis.js",
      "require": "./dist/apis.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "taro",
    "taro-plugin",
    "platform",
    "macle",
    "miniprogram",
    "huawei",
    "ethio-telecom"
  ],
  "author": "Macle Team",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@tarojs/service": ">=3.6.0",
    "@tarojs/shared": ">=3.6.0"
  },
  "peerDependencies": {
    "@tarojs/service": ">=3.6.0",
    "@tarojs/shared": ">=3.6.0"
  },
  "devDependencies": {
    "@tarojs/service": "^4.0.0",
    "@tarojs/shared": "^4.0.0",
    "@types/node": "^18.15.11",
    "@types/react": "^18.3.31",
    "typescript": "^5.0.4"
  }
}
